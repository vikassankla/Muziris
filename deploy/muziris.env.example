# The configuration of a pilot install (ADR 0029). Copy it to /etc/muziris/muziris.env, fill in
# every value, then: sudo chown root:root /etc/muziris/muziris.env && sudo chmod 600 it.
# Never commit the filled-in file, and never paste it into a ticket or a chat.

# The two hostnames, each with a DNS record pointing at this VM. Each app gets its own.
ADMIN_DOMAIN=
STOREFRONT_DOMAIN=
# Let's Encrypt writes here about certificates that are about to expire.
ACME_EMAIL=

# The organization `setup` creates on an empty install; ignored once one exists.
ORGANIZATION_NAME=
# The code of the website the storefront serves. Create it under System > Websites.
STOREFRONT_WEBSITE=main

# PostgreSQL, run in this stack. Use letters and digits only (openssl rand -hex 24): the
# password goes into a connection URL.
POSTGRES_USER=muziris
POSTGRES_PASSWORD=
POSTGRES_DB=muziris

# Encrypts admins' two-factor secrets (ADR 0026): openssl rand -base64 32. Back it up with the
# database dumps, apart from the VM: without it every admin enrols again after a restore.
ADMIN_TOTP_KEY=

# Email (ADR 0020), from your mail provider. SMTP_URL can hold its password.
# smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Your Company <orders@example.com>

# Payment gateways (ADR 0019), test mode for the pilot. A gateway is on only when all three of
# its variables are set. Live keys are refused unless PAYMENTS_LIVE=true.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# At least 16 random characters (openssl rand -hex 16), typed into Razorpay's dashboard too.
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_LIVE=false

# Optional.
# LOG_LEVEL=info
# Where the daily dumps go on the VM.
# BACKUP_DIR=/var/backups/muziris
# Tags the built images, for example with the release you checked out.
# MUZIRIS_VERSION=v0.1.0
