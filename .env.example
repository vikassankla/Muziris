# Copy to .env and change every value marked CHANGE_ME. Never commit .env.

# Local services (docker-compose.yml)
POSTGRES_USER=muziris
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=muziris

# API
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://muziris:CHANGE_ME@127.0.0.1:5432/muziris
# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Object storage (SeaweedFS S3 gateway from docker-compose.yml)
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=muziris-media

# Email (Mailpit from docker-compose.yml)
SMTP_URL=smtp://127.0.0.1:1025
