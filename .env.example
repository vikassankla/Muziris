# Copy to .env and change every value marked CHANGE_ME. Never commit .env.

# Local services (docker-compose.yml)
POSTGRES_USER=muziris
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=muziris

# API
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://muziris:CHANGE_ME@127.0.0.1:5432/muziris
# Comma-separated list of origins allowed to call the API from a browser, and the only origins
# allowed to sign in or change data with cookies. http://localhost:5173 is the admin app's dev
# server (apps/admin), which proxies /admin/v1 to this API; http://localhost:5174 is the
# storefront's (apps/storefront), which proxies /storefront/v1.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
# Reverse proxies in front of the API whose X-Forwarded-For is trusted. 0 when none.
TRUSTED_PROXY_HOPS=0

# Storefront GraphQL API (ADR 0014). Ad hoc queries default to allow outside production and
# must be deny in production, where only the persisted queries in this JSON file run.
# STOREFRONT_ADHOC_QUERIES=allow
# The storefront app's operations (apps/storefront, ADR 0015); the path is from apps/api.
# STOREFRONT_PERSISTED_QUERIES=../storefront/persisted-queries.json

# Storefront app (apps/storefront): the code of the website it serves.
VITE_STOREFRONT_WEBSITE=main

# Object storage (SeaweedFS S3 gateway from docker-compose.yml)
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=muziris-media

# Email (Mailpit from docker-compose.yml)
SMTP_URL=smtp://127.0.0.1:1025
