# Copy to .env and change every value marked CHANGE_ME. Never commit .env.

# Local services (docker-compose.yml)
POSTGRES_USER=muziris
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=muziris

# API
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://muziris:CHANGE_ME@127.0.0.1:5432/muziris
# The key that encrypts admins' two-factor secrets (ADR 0026): 32 random bytes in base64, from
# `openssl rand -base64 32`. Required in production; without it admins cannot finish signing
# in. Back it up with the database credentials: losing it means every admin enrols again.
ADMIN_TOTP_KEY=CHANGE_ME
# Comma-separated list of origins allowed to call the API from a browser, and the only origins
# allowed to sign in or change data with cookies. http://localhost:5173 is the admin app's dev
# server (apps/admin), which proxies /admin/v1 to this API; http://localhost:5174 is the
# storefront's (apps/storefront), which proxies /storefront/v1.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
# Reverse proxies in front of the API whose X-Forwarded-For is trusted. 0 when none.
TRUSTED_PROXY_HOPS=0

# Storefront GraphQL API (ADR 0014). Ad hoc queries default to allow outside production and
# must be deny in production, where only the persisted queries in this JSON file run.
# STOREFRONT_ADHOC_QUERIES=allow
# The storefront app's operations (apps/storefront, ADR 0015); the path is from apps/api.
# STOREFRONT_PERSISTED_QUERIES=../storefront/persisted-queries.json

# Payment gateways (ADR 0019), test mode. A gateway is on only when all three of its variables
# are set; some but not all stops the API at startup. Live keys (sk_live_, pk_live_, rzp_live_)
# are refused unless PAYMENTS_LIVE=true. Keys live here and in the deployment's secret store
# only: never in the database, the admin settings or the repository.
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# PAYMENTS_LIVE=false

# Storefront app (apps/storefront): the code of the website it serves.
VITE_STOREFRONT_WEBSITE=main

# Object storage (SeaweedFS S3 gateway from docker-compose.yml)
S3_ENDPOINT=http://127.0.0.1:8333
S3_BUCKET=muziris-media

# Email (ADR 0020; Mailpit from docker-compose.yml, whose inbox is at http://localhost:8025).
# SMTP_URL can hold the mail server's password: keep it here and in the secret store only.
# Without it emails are queued but not sent. All three are required in production.
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=Muziris <no-reply@muziris.localhost>
# The storefront's public address, for links in emails.
STOREFRONT_PUBLIC_URL=http://localhost:5174
# The code of the website that storefront serves; invitation emails use its name and time zone.
# STOREFRONT_WEBSITE=main

# Background jobs (ADR 0025): price, visibility and search builds, emails, session clean-up.
# By default the API runs them. Set false to run them in `pnpm --filter @muziris/api worker`
# instead, which answers /health/live on WORKER_PORT.
# JOB_WORKERS=true
# WORKER_PORT=4001
