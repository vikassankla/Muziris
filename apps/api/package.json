{
  "name": "@muziris/api",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "admin:create": "tsx --env-file-if-exists=../../.env src/cli/create-admin.ts",
    "admin:reset-2fa": "tsx --env-file-if-exists=../../.env src/cli/reset-two-factor.ts",
    "admin:rotate-2fa-key": "tsx --env-file-if-exists=../../.env src/cli/rotate-two-factor-key.ts",
    "demo:seed": "tsx --env-file-if-exists=../../.env src/cli/seed-demo.ts",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "notifications:send": "tsx --env-file-if-exists=../../.env src/cli/send-emails.ts",
    "pricing:build": "tsx --env-file-if-exists=../../.env src/cli/build-prices.ts",
    "search:build": "tsx --env-file-if-exists=../../.env src/cli/build-search.ts",
    "setup": "tsx --env-file-if-exists=../../.env src/cli/setup.ts",
    "start": "tsx src/server.ts",
    "storefront:schema": "tsx src/cli/print-storefront-schema.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "visibility:build": "tsx --env-file-if-exists=../../.env src/cli/build-visibility.ts",
    "worker": "tsx --env-file-if-exists=../../.env src/worker.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@muziris/access": "workspace:*",
    "@muziris/catalog": "workspace:*",
    "@muziris/csv": "workspace:*",
    "@muziris/customers": "workspace:*",
    "@muziris/db": "workspace:*",
    "@muziris/identity": "workspace:*",
    "@muziris/jobs": "workspace:*",
    "@muziris/money": "workspace:*",
    "@muziris/notifications": "workspace:*",
    "@muziris/orders": "workspace:*",
    "@muziris/payments": "workspace:*",
    "@muziris/platform": "workspace:*",
    "@muziris/pricing": "workspace:*",
    "@muziris/search": "workspace:*",
    "@muziris/shopping-lists": "workspace:*",
    "@muziris/tax": "workspace:*",
    "@muziris/visibility": "workspace:*",
    "@muziris/workflow": "workspace:*",
    "graphql": "^17.0.2",
    "hono": "^4.13.14",
    "pino": "^10.4.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.4"
  }
}
